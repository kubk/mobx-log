{
  "version": "2.4.0",
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "repository": "https://github.com/kubk/mobx-log",
  "main": "dist/index.js",
  "types": "dist/mobx-log.d.ts",
  "scripts": {
    "build": "rollup -c",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:oxlint": "oxlint --format=agent",
    "lint:slop-police": "slop-police",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "mobx": "^6.3.4 || ^7.0.0",
    "react": ">=16"
  },
  "name": "mobx-log",
  "author": "Egor Gorbachev",
  "module": "dist/mobx-log.esm.js",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/mobx-log.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^23.0.2",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-typescript": "^9.0.2",
    "@size-limit/preset-small-lib": "^5.0.3",
    "@types/node": "18.11.18",
    "@types/react": "^18.3.31",
    "jsdom": "^25.0.1",
    "lefthook": "^2.1.14",
    "mobx": "^7.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "^18.3.1",
    "rollup": "^2.61.1",
    "rollup-plugin-dts": "^4.0.1",
    "size-limit": "^5.0.3",
    "slop-police": "^0.3.9",
    "tslib": "^2.3.1",
    "typescript": "^4.9.0",
    "vitest": "^2.1.4"
  }
}
